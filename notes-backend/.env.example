# Copy this file to `.dev.vars` and fill in real values for local dev.
# .dev.vars is gitignored — never commit it.
#
# In Cloudflare production, set via:
#   wrangler secret put JWT_SECRET
#   wrangler secret put UPSTASH_REDIS_REST_URL
#   wrangler secret put UPSTASH_REDIS_REST_TOKEN

JWT_SECRET="replace-with-32-bytes-random-hex"

# Upstash Redis (https://console.upstash.com) — REST credentials for the
# query-level cache. Leaving either value blank disables caching entirely
# (the request still succeeds against D1).
UPSTASH_REDIS_REST_URL="https://<name>.upstash.io"
UPSTASH_REDIS_REST_TOKEN="<upstash-rest-token>"